{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "VoxelBill (Formerly known as BJTMastermind)",
        "QWERTY770 (Upstream Mantainer)"
    ],
    "contact": {
        "sources": "${mod_github}",
        "issues": "${mod_github}/issues"
    },
    "license": "${mod_license}",
    "icon": "${mod_icon}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "me.voxelbill.easy_data_fix.fabric.EasyDataFixModFabric"
        ]
    },
    "mixins": [
        "easy_data_fix.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": ">=${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}